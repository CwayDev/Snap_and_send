# Google Gemini / Gemma API Key (get from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Snowflake Connection Configuration (Uses browser login: externalbrowser)
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SNAP_DB
SNOWFLAKE_SCHEMA=APP

# Supported Languages for Multilingual Explanations (comma-separated)
TARGET_LANGUAGES=Hausa,French
